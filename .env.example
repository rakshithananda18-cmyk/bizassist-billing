# BizAssist environment variables
# Copy this file to backend\.env and fill in your values.
# Production uses Google Cloud Run. Keep credentials in Secret Manager; the deploy
# scripts mount secrets and preserve other settings with --update-env-vars.
# See docs/runbooks/cloud-run-migration.md for the ordered release checklist.

# ════════════════════════════════════════════════════════════════
# REQUIRED
# ════════════════════════════════════════════════════════════════

# Groq API key — powers all LLM tiers + the LLM router.
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Auth token signing secret — use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-secret

# No administrator is created automatically in non-test environments. Provision
# production admin accounts through the controlled deployment/operations path
# before enabling ADMIN_API_ENABLED. ADMIN_SEED_PASSWORD is test-only.

# ════════════════════════════════════════════════════════════════
# ROUTING & AGENT  (recommended values shown)
# ════════════════════════════════════════════════════════════════

# Router mode at startup: off (legacy) | shadow | on (new LLM router).
# The admin override is stored durably and survives restarts.
LLM_ROUTER=off
# Below this confidence the LLM router defers to the legacy router.
LLM_ROUTER_CONF_FLOOR=0.6
# AI_COMPLEX engine: loop (adaptive tool-calling, cheaper) | pipeline (fixed fan-out).
AGENT_MODE=loop
# Embedding shadow router: off | shadow | on. shadow is free (local model).
INTENT_ROUTER=shadow
# Inject the deterministic business snapshot into AI_SIMPLE answers.
SNAPSHOT_CONTEXT=true
# Semantic recall of past conversations, added to AI_SIMPLE prompts.
#
# DEFAULTS OFF, and leave it off for local development. It reads a persisted
# Chroma HNSW index, and concurrent access to that index blocks in native code
# while holding the GIL — which freezes the WHOLE backend, not just the request:
# port open, requests accepted, nothing ever answered, nothing logged.
# `uvicorn --reload` is enough to cause it, because the reloader and the worker
# both import the app and touch one index.
#
# Enable only for a single process with durable vector storage. Cloud Run uses
# WEB_CONCURRENCY=1 and --max-instances 1; local instance files are ephemeral.
CHAT_MEMORY_ENABLED=0
# Bounds for the agent loop.
AGENT_MAX_TOOL_ROUNDS=5
MAX_TOOL_CHARS=4000

# ════════════════════════════════════════════════════════════════
# INFRASTRUCTURE
# ════════════════════════════════════════════════════════════════

# Database (DATABASE_URL). The app + alembic both read this one variable.
#   - Local dev (Docker Postgres):  postgresql://postgres:devpass@localhost:5432/bizassist
#   - Cloud Run (Supabase):        mount DATABASE_URL from Secret Manager
#   - Zero-setup fallback:          sqlite:///./bizassist.db
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/bizassist

# Keep at 1 — caches, rate-limit windows, and the scheduler are in-memory.
WEB_CONCURRENCY=1

# ── Admin Console (organiser-only) ──────────────────────────────
# Fail-closed gate for ALL /admin/* endpoints. Default (unset/0) = the admin
# API does not exist (404) — the desktop/PyInstaller build must NEVER set this.
# Set to 1 only on the organiser cloud backend (the Cloud Run scripts set it).
# ADMIN_API_ENABLED=1

# Subscription enforcement (Phase B.5). 0 (default) = plan hooks are dormant:
# admins can grant/revoke plans in the console but nothing is blocked yet.
# 1 = /ask* and hybrid-sync activation require an active "pro" plan.
SUBSCRIPTION_ENFORCED=0

# Pro trial for every new business registered on the CLOUD backend (days).
# Default 14; 0 turns the trial off. Local/desktop signups never get one — they
# read the plan from the cloud. One trial per phone number.
# PRO_TRIAL_DAYS=14

# Logging level: INFO normally, DEBUG to trace routing. Cloud Run uses stdout.
LOG_LEVEL=INFO

# CORS — comma-separated. Leave UNSET to use the built-in defaults
# (staterbill.com, www, admin and current Vercel apps). Entries ADD to those
# defaults. Localhost and private LAN origins are handled by the local-origin rule.
# ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ════════════════════════════════════════════════════════════════
# MODEL OVERRIDES  (optional — code defaults already use these)
# ════════════════════════════════════════════════════════════════
# Groq retires models (console.groq.com/docs/deprecations): llama-4-scout and
# qwen3-32b went 2026-07-17, llama-3.3-70b 2026-08-16. A retired model answers
# 404 "does not exist or you do not have access". Defaults (services/groq_client.py,
# checked 2026-10-24): qwen3.8-27b fast + reads images, gpt-oss-120b most accurate.
# Each setting is a list, first choice first: when Groq refuses one as gone,
# billing logs a warning and uses the next. If Groq retires one, replace it
# here and restart.
# GROQ_MODEL_ROUTER=qwen/qwen3.8-27b,openai/gpt-oss-120b      # unset: GROQ_MODEL_SIMPLE
# GROQ_MODEL_SIMPLE=qwen/qwen3.8-27b,openai/gpt-oss-120b
# GROQ_MODEL_COMPLEX=openai/gpt-oss-120b,qwen/qwen3.8-27b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b          # bill-photo OCR (must read images)
# GROQ_REASONING_EFFORT=low                   # gpt-oss thinking: low | medium | high

# ════════════════════════════════════════════════════════════════
# EMAIL (optional — only needed to SEND real payment reminders)
# Gmail: use an App Password, not your login password.
# https://support.google.com/accounts/answer/185833
# ════════════════════════════════════════════════════════════════
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=your_email@gmail.com

# ════════════════════════════════════════════════════════════════
# OPTIONAL AI KEYS
# ════════════════════════════════════════════════════════════════
# Claude — fallback for PDF invoice parsing (optional).
# CLAUDE_API_KEY=your_anthropic_api_key_here
# Legacy / unused in the Groq path:
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ════════════════════════════════════════════════════════════════
# WhatsApp (Twilio) — not wired up yet; reserved for later.
# ════════════════════════════════════════════════════════════════
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Shared desktop cloud endpoint (same default when unset; no .env in installers).
CLOUD_API_URL=https://staterbill-api-1076771386585.asia-south1.run.app
# Cloud Run uses externally triggered scheduled jobs. Mount this as a secret.
# BILLING_CRON_SECRET=<Secret Manager only>
CLOUD_RUN_REGION=asia-south1
SSE_MAX_STREAM_SECONDS=100
# ADMIN_SERVICE_URL=<optional privileged admin DB URL mounted from Secret Manager>
