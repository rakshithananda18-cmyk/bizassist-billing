# Python
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Environment — never commit API keys
.env
backend/.env

# Sync tokens — runtime credentials, never commit.
# NOT path-anchored: `_TOKEN_FILE = Path("cloud_sync_tokens.json")` in
# services/sync_worker.py is CWD-relative ("the app-data dir (packaged) /
# backend/ (dev)"), so any backend module imported from the repo root writes the
# file HERE instead. Anchoring this to backend/ left that copy untracked-but-not-
# ignored — one `git add -A` from committing live cloud bearer JWTs. Reproduced
# accidentally on 2026-08-03. Match it at any depth.
cloud_sync_tokens.json

# Admin audit trail — runtime data (may reference businesses)
backend/logs/admin_audit.jsonl
backend/logs/telemetry.jsonl

# Database — local data, not for version control
*.db
*.sqlite
*.sqlite3

# Logs — never commit (may contain customer data from request traces)
*.log
backend/logs/

# User uploads — runtime data, not for version control
backend/uploads/
uploads/

# Audit / diagnosis output — REAL BUSINESS DATA, never version-controlled.
# scripts/audit_money_integrity.py and diagnose_money_findings.py print invoice
# numbers, amounts, BizIDs and per-business exposure. Useful to keep locally and
# to paste into a ticket; not something to put in a repo, least of all one that
# may be public. The repair's row-level export is the same.
backend/cloud_audit*.txt
backend/cloud_diagnosis*.txt
backend/*_export_*.json
backend/phantom_line_items_export_*.json

# Test / tooling caches
.pytest_cache/
*.egg-info/
.coverage
# pytest-cov writes one parallel data file per process (.coverage.<host>.<pid>.<rand>)
# and leaves them behind whenever the combine step cannot delete them.
.coverage.*
htmlcov/

# VS Code
.vscode/

# OS
.DS_Store
Thumbs.db

# Scratch directory
scratch/

# Local config
frontend/js/config.js

# Vector database persistence
backend/chroma_db/

# Node
node_modules/
dist/
.eslintcache


# Database backups and logs.
#
# These lines previously appeared TWICE: once here in UTF-8 and once, just
# above, as UTF-16LE bytes appended by PowerShell (Out-File/Add-Content default
# to UTF-16 on Windows PowerShell 5.1). Git reads .gitignore as bytes, so the
# UTF-16 copy matched nothing and showed the whole file as `Bin` in every diff.
# It was harmless only by accident — the UTF-8 duplicate below did the work.
#
# Nothing was exposed (checked: no .db, .bak, .log or test_results.json has ever
# been tracked), but a .gitignore git cannot diff is one nobody reviews, and
# these patterns cover 9 MB database backups and logs full of customer names,
# invoice numbers and amounts. This repo pushes to a PUBLIC Hugging Face Space.
#
# On Windows, append with `Out-File -Encoding utf8` or edit in a real editor.
backend/bizassist.db.bak
*.bak-*
*.clean-bak
*.db-journal
test_results.json
logs/

# Repair-script exports. These are reversibility snapshots of REAL rows —
# customer names, invoice numbers, line items — written before a destructive
# repair. Useful locally, must never be committed.
backend/fk_orphans_export_*.json
backend/quarantined_payments_*.json
backend/phantom_line_items_export_*.json
fk_orphans_export_*.json
quarantined_payments_*.json
phantom_line_items_export_*.json

