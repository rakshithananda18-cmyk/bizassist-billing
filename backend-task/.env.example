# BizAssist Task (Field Team) — environment.
# Local: backend-task/.env (start_dev.bat copies this file there).
# Cloud Run: deploy_cloudrun.ps1 sets these — DATABASE_URL, JWT_SECRET and
# TASK_CRON_SECRET as Secret Manager secrets, the rest as env vars.

# ════════════════════════ REQUIRED ════════════════════════
# The SAME database as the BizAssist billing Space (Supabase Postgres). One
# owner account, one BizID and the same customers across both apps.
#   start_dev.bat overrides this with billing's local database (dev/dev_env.ps1).
#   Run on its own:  sqlite:///./bizassist_task.db   (creates a minimal users/customers copy)
DATABASE_URL=sqlite:///./bizassist_task.db

# The SAME value as the billing Space's JWT_SECRET (>= 32 bytes). Lets an owner
# exchange a billing session for a task session (SSO). Field-staff tokens are
# signed with a key DERIVED from it, which billing cannot verify.
JWT_SECRET=change-this-to-the-billing-jwt-secret-0123456789

# ════════════════════════ OPTIONAL ════════════════════════
# Business wall clock for attendance dates, lateness and "today's route".
BIZ_TIMEZONE=Asia/Kolkata
# Run this app's own Alembic chain (ft_* tables only) on startup.
TASK_AUTO_MIGRATE=1
# Create minimal users/customers tables when they don't exist. Default: on for
# SQLite, OFF for Postgres (billing owns those tables). Leave unset in prod.
# TASK_CREATE_BILLING_MIRROR=0
# Allow "Create account" from the task app (row is identical to billing's signup).
# Ignored while the Pro gate is on: accounts start in BizAssist Billing then.
TASK_ALLOW_SIGNUP=1
# Field Team is part of BizAssist Pro — same switch as billing's. 1 = refuse
# businesses whose owner is not on Pro (billing's admin console grants it).
# Off locally; Cloud Run: deploy_cloudrun.ps1 -ProGate on.
# SUBSCRIPTION_ENFORCED=0
# Days Field Team keeps working after a Pro plan expires (owner is warned).
# TASK_PRO_GRACE_DAYS=7
# Raw GPS points older than this are deleted (event locations are kept).
TASK_PING_RETENTION_DAYS=60
# In-process purge every 6 h. Cloud Run: 0 (CPU only runs during requests) —
# Cloud Scheduler calls POST /api/internal/purge-pings with X-Cron-Secret.
TASK_PURGE_LOOP=1
# Secret for that endpoint; unset = the endpoint does not exist (404).
# TASK_CRON_SECRET=
# Session length for owners and staff (minutes). 840 = 14 h, a full shift.
TASK_TOKEN_TTL_MINUTES=840
# CORS origins = the Vercel URL of the screens (deploy_cloudrun.ps1 -AllowedOrigins). Setting it
# REPLACES the localhost dev defaults; localhost/LAN stay allowed by pattern.
# ALLOWED_ORIGINS=https://bizassist-task.vercel.app

# Logging — same switches as billing (app/logging_config.py).
LOG_LEVEL=INFO
# LOG_FILE=logs/bizassist_task.log   # rotating file (start_dev.bat sets this); not on Cloud Run
# LOG_FORMAT=json                    # ECS-style JSON lines

# ── Frontend build-time — set in the Vercel project, not here ──
# VITE_API_URL=https://bizassist-task-<hash>.asia-south1.run.app   (the Cloud Run service URL)
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
